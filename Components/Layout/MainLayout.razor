@inherits LayoutComponentBase
@inject AppStateService AppState
@inject SchoolDataService Data
@implements IDisposable

<div class="page">
    <aside class="sidebar">
        <div class="profile-summary">
            <div class="profile-avatar" title="@AppState.CurrentStudentName">
                @if (!string.IsNullOrWhiteSpace(AppState.CurrentStudentPhotoDataUrl))
                {
                    <img src="@AppState.CurrentStudentPhotoDataUrl" alt="Student profile photo" />
                }
                else
                {
                    <span>@AppState.GetStudentInitials()</span>
                }
            </div>
            <small>@AppState.CurrentStudentName</small>
        </div>

        <NavMenu />
    </aside>

    <main>
        <header class="top-row">
            <div>
                <strong>Role:</strong> @AppState.CurrentRole
            </div>

            <div class="header-actions">
                <button type="button" class="icon-btn" title="Alerts" aria-label="Alerts">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4a5 5 0 0 0-5 5v3.5L5 15v1h14v-1l-2-2.5V9a5 5 0 0 0-5-5z"/><path d="M10 18a2 2 0 0 0 4 0"/></svg>
                    @if (AlertCount > 0)
                    {
                        <span class="icon-badge">@AlertCount</span>
                    }
                </button>

                <button type="button" class="icon-btn" title="Pending contact" aria-label="Pending contact">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16v11H7l-3 3z" /><path d="M8 9h8" /><path d="M8 12h6" /></svg>
                    @if (PendingMessageCount > 0)
                    {
                        <span class="icon-badge">@PendingMessageCount</span>
                    }
                </button>

                <button type="button" class="icon-btn" title="Log out" aria-label="Log out" @onclick="Logout">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 4H5v16h5" /><path d="M14 8l5 4-5 4" /><path d="M8 12h11" /></svg>
                </button>
            </div>
        </header>

        <section class="content">
            @Body
        </section>
    </main>
</div>

@code {
    private int PendingMessageCount => Data.AdminMessages
        .Count(m => string.Equals(m.StudentName, AppState.CurrentStudentName, StringComparison.OrdinalIgnoreCase)
                    && string.IsNullOrWhiteSpace(m.AdminReply));

    private int AlertCount => Data.AdminMessages
        .Count(m => string.Equals(m.StudentName, AppState.CurrentStudentName, StringComparison.OrdinalIgnoreCase)
                    && !string.IsNullOrWhiteSpace(m.AdminReply));

    protected override void OnInitialized()
    {
        AppState.OnChange += StateHasChanged;
    }

    private void Logout()
    {
        AppState.Logout();
    }

    public void Dispose()
    {
        AppState.OnChange -= StateHasChanged;
    }
}
