@inherits LayoutComponentBase
@inject AppStateService AppState
@implements IDisposable

<div class="page">
    <aside class="sidebar">
        <div class="profile-summary">
            <div class="profile-avatar" title="@AppState.CurrentStudentName">
                @if (!string.IsNullOrWhiteSpace(AppState.CurrentStudentPhotoDataUrl))
                {
                    <img src="@AppState.CurrentStudentPhotoDataUrl" alt="Student profile photo" />
                }
                else
                {
                    <span>@AppState.GetStudentInitials()</span>
                }
            </div>
            <small>@AppState.CurrentStudentName</small>
        </div>

        <NavMenu />
    </aside>

    <main>
        <header class="top-row">
            <div>
                <strong>Role:</strong> @AppState.CurrentRole
            </div>
            @if (AppState.CurrentRole == UserRole.Student)
            {
                <div><strong>Student:</strong> @AppState.CurrentStudentName</div>
            }
        </header>

        <section class="content">
            @Body
        </section>
    </main>
</div>

@code {
    protected override void OnInitialized()
    {
        AppState.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        AppState.OnChange -= StateHasChanged;
    }
}
