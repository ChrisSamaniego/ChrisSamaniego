@page "/student/home"
@inject AppStateService AppState
@inject SchoolDataService Data
@inject LanguageService Lang

<PageTitle>@Lang.T("Student Home", "Inicio del estudiante")</PageTitle>

<div class="dashboard-layout">
    <section class="panel dashboard-header">
        <div>
            <h1>@Lang.T("Home", "Inicio")</h1>
            <p>@Lang.T("Dashboard overview with courses, timeline, and communication status.", "Resumen del panel con cursos, cronograma y estado de comunicación.")</p>
        </div>

        <div class="role-switcher">
            <button class="btn" @onclick="() => AppState.SetRole(UserRole.Administrator)">@Lang.T("Administrator", "Administrador")</button>
            <button class="btn" @onclick="() => AppState.SetRole(UserRole.Teacher)">@Lang.T("Teacher", "Docente")</button>
            <button class="btn" @onclick="() => AppState.SetRole(UserRole.Student)">@Lang.T("Student", "Estudiante")</button>
        </div>
    </section>

    <section class="kpi-grid">
        <article class="kpi-card">
            <h4>@Lang.T("Attendance", "Asistencia")</h4>
            <strong>96%</strong>
            <small>@Lang.T("Current month average", "Promedio del mes actual")</small>
        </article>
        <article class="kpi-card">
            <h4>@Lang.T("Upcoming tests", "Próximos exámenes")</h4>
            <strong>2</strong>
            <small>@Lang.T("Next 7 days", "Próximos 7 días")</small>
        </article>
        <article class="kpi-card">
            <h4>@Lang.T("Unread contacts", "Contactos no leídos")</h4>
            <strong>1</strong>
            <small>@Lang.T("From administration", "De administración")</small>
        </article>
        <article class="kpi-card">
            <h4>@Lang.T("Classes this week", "Clases esta semana")</h4>
            <strong>@AssignedCourses.Count()</strong>
            <small>@Lang.T("Assigned to", "Asignado a") @AppState.CurrentStudentName</small>
        </article>
    </section>

    <section class="dashboard-content-grid">
        <article class="panel course-chart-panel">
            <h3>@Lang.T("Course timeline and result", "Cronograma y resultado del curso")</h3>
            @foreach (var course in CourseChart)
            {
                <div class="course-row">
                    <div class="course-meta">
                        <strong>@course.Name</strong>
                        <small>@course.RemainingDays @Lang.T("day(s) remaining", "día(s) restantes")</small>
                    </div>
                    <div class="course-bar-track">
                        <div class="course-bar-fill" style="width:@course.BarWidth%"></div>
                    </div>
                    <span class="status-tag @(course.Passed ? "passed" : "not-passed")">
                        @(course.Passed ? Lang.T("Pass", "Aprobado") : Lang.T("Not pass", "No aprobado"))
                    </span>
                </div>
            }
        </article>

        <article class="panel">
            <h3>@Lang.T("Student profile quick edit", "Edición rápida del perfil")</h3>
            <EditForm Model="studentState" OnValidSubmit="SaveStudentName" FormName="student-home-name-form">
                <DataAnnotationsValidator />
                <div class="form-grid">
                    <label for="studentName">@Lang.T("Student name", "Nombre del estudiante")</label>
                    <InputText id="studentName" @bind-Value="studentState.Name" />
                    <button class="btn" type="submit">@Lang.T("Save profile", "Guardar perfil")</button>
                </div>
            </EditForm>
        </article>
    </section>
</div>

@code {
    private StudentState studentState = new() { Name = "Student One" };

    private readonly Dictionary<string, int> courseGrades = new()
    {
        ["Mathematics 101"] = 84,
        ["World History"] = 62,
        ["Physics Lab"] = 78
    };

    private IEnumerable<ClassSchedule> AssignedCourses => Data.Schedules
        .Where(s => s.AssignedStudents.Contains(AppState.CurrentStudentName, StringComparer.OrdinalIgnoreCase));

    private IEnumerable<CourseItem> CourseChart
    {
        get
        {
            var courses = AssignedCourses
                .Select(s => new
                {
                    s.Name,
                    RemainingDays = Math.Max(0, (s.Start.Date - DateTime.Today).Days + 1),
                    Passed = courseGrades.TryGetValue(s.Name, out var grade) && grade >= 70
                })
                .ToList();

            var maxRemaining = Math.Max(1, courses.DefaultIfEmpty().Max(c => c?.RemainingDays ?? 1));

            return courses.Select(c => new CourseItem(
                c.Name,
                c.RemainingDays,
                c.Passed,
                Math.Max(8, (int)Math.Round((double)c.RemainingDays / maxRemaining * 100))));
        }
    }

    private void SaveStudentName()
    {
        AppState.SetStudentName(studentState.Name);
    }

    private class StudentState
    {
        [Required]
        public string Name { get; set; } = string.Empty;
    }

    private record CourseItem(string Name, int RemainingDays, bool Passed, int BarWidth);
}
