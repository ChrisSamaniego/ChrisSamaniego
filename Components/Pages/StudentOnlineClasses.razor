@page "/student/online-classes"
@inject AppStateService AppState

<PageTitle>Online classes</PageTitle>

@if (AppState.CurrentRole != UserRole.Student)
{
    <div class="panel"><p>Switch to Student role.</p></div>
}
else
{
    <div class="panel">
        <h2>Online classes</h2>
        <p>Watch class videos from your teachers.</p>

        <div class="video-grid">
            @foreach (var video in videos)
            {
                <article class="video-card">
                    <h3>@video.Title</h3>
                    <iframe src="@video.Url"
                            title="@video.Title"
                            loading="lazy"
                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                            referrerpolicy="strict-origin-when-cross-origin"
                            allowfullscreen>
                    </iframe>
                </article>
            }
        </div>
    </div>
}

@code {
    private readonly List<OnlineVideo> videos =
    [
        new("Algebra Basics", "https://www.youtube.com/embed/ERQx7eznH4s"),
        new("World History Overview", "https://www.youtube.com/embed/xuCn8ux2gbs"),
        new("Physics Intro", "https://www.youtube.com/embed/ZihywtixUYo")
    ];

    private record OnlineVideo(string Title, string Url);
}
