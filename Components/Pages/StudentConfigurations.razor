@page "/student/configurations"
@page "/student/configuration"
@inject AppStateService AppState
@inject LanguageService Lang

<PageTitle>@Lang.T("Configurations", "Configuración")</PageTitle>

@if (AppState.CurrentRole != UserRole.Student)
{
    <div class="panel"><p>@Lang.T("Switch to Student role.", "Cambia al rol de Estudiante.")</p></div>
}
else
{
    <div class="panel">
        <h2>@Lang.T("Configurations", "Configuración")</h2>
        <EditForm Model="model" OnValidSubmit="Save" FormName="student-config-name-form">
            <DataAnnotationsValidator />
            <div class="form-grid">
                <label for="studentName">@Lang.T("Display name", "Nombre visible")</label>
                <InputText id="studentName" @bind-Value="model.Name" />
                <button class="btn" type="submit">@Lang.T("Save", "Guardar")</button>
            </div>
        </EditForm>

        <div class="profile-upload-block">
            <h3>@Lang.T("Profile photo", "Foto de perfil")</h3>
            <p>@Lang.T("Upload your profile image. If no photo is uploaded, initials will be shown in the circle.", "Sube tu imagen de perfil. Si no se sube una foto, se mostrarán iniciales en el círculo.")</p>

            <InputFile OnChange="OnFileSelected" accept="image/*" />

            @if (!string.IsNullOrWhiteSpace(AppState.CurrentStudentPhotoDataUrl))
            {
                <div class="profile-preview">
                    <img src="@AppState.CurrentStudentPhotoDataUrl" alt="Profile preview" />
                    <button type="button" class="btn" @onclick="RemovePhoto">@Lang.T("Remove photo", "Eliminar foto")</button>
                </div>
            }
        </div>

        <div class="profile-upload-block">
            <h3>@Lang.T("Change password", "Cambiar contraseña")</h3>
            <EditForm Model="passwordModel" OnValidSubmit="ChangePassword" FormName="student-config-password-form">
                <DataAnnotationsValidator />
                <div class="form-grid">
                    <label for="currentPassword">@Lang.T("Current password", "Contraseña actual")</label>
                    <InputText id="currentPassword" type="password" @bind-Value="passwordModel.CurrentPassword" />
                    <label for="newPassword">@Lang.T("New password", "Nueva contraseña")</label>
                    <InputText id="newPassword" type="password" @bind-Value="passwordModel.NewPassword" />
                    <label for="confirmPassword">@Lang.T("Confirm new password", "Confirmar nueva contraseña")</label>
                    <InputText id="confirmPassword" type="password" @bind-Value="passwordModel.ConfirmPassword" />
                    <button class="btn" type="submit">@Lang.T("Update password", "Actualizar contraseña")</button>
                </div>
            </EditForm>

            @if (!string.IsNullOrWhiteSpace(passwordMessage))
            {
                <p class="status-text">@passwordMessage</p>
            }
        </div>
    </div>
}

@code {
    private StudentConfig model = new() { Name = "Student One" };
    private PasswordConfig passwordModel = new();
    private string passwordMessage = string.Empty;

    protected override void OnInitialized()
    {
        model.Name = AppState.CurrentStudentName;
    }

    private void Save()
    {
        AppState.SetStudentName(model.Name);
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null)
        {
            return;
        }

        await using var stream = file.OpenReadStream(2 * 1024 * 1024);
        using var memory = new MemoryStream();
        await stream.CopyToAsync(memory);

        var base64 = Convert.ToBase64String(memory.ToArray());
        var dataUrl = $"data:{file.ContentType};base64,{base64}";
        AppState.SetStudentPhoto(dataUrl);
    }

    private void RemovePhoto()
    {
        AppState.SetStudentPhoto(null);
    }

    private void ChangePassword()
    {
        if (string.IsNullOrWhiteSpace(passwordModel.CurrentPassword))
        {
            passwordMessage = Lang.T("Please enter your current password.", "Ingresa tu contraseña actual.");
            return;
        }

        if (passwordModel.NewPassword.Length < 6)
        {
            passwordMessage = Lang.T("New password must contain at least 6 characters.", "La nueva contraseña debe contener al menos 6 caracteres.");
            return;
        }

        if (!string.Equals(passwordModel.NewPassword, passwordModel.ConfirmPassword, StringComparison.Ordinal))
        {
            passwordMessage = Lang.T("New password and confirmation do not match.", "La nueva contraseña y la confirmación no coinciden.");
            return;
        }

        passwordModel = new PasswordConfig();
        passwordMessage = Lang.T("Password updated successfully.", "Contraseña actualizada correctamente.");
    }

    private class StudentConfig
    {
        [Required]
        public string Name { get; set; } = string.Empty;
    }

    private class PasswordConfig
    {
        [Required]
        public string CurrentPassword { get; set; } = string.Empty;

        [Required]
        public string NewPassword { get; set; } = string.Empty;

        [Required]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
