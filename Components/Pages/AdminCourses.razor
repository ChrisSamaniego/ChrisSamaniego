@page "/admin/courses"
@inject AppStateService AppState
@inject SchoolDataService Data
@inject LanguageService Lang

<PageTitle>@Lang.T("Create Courses", "Crear cursos")</PageTitle>

@if (AppState.CurrentRole != UserRole.Administrator)
{
    <div class="panel"><p>@Lang.T("Switch to Administrator role.", "Cambia al rol de Administrador.")</p></div>
}
else
{
    <div class="panel">
        <h2>@Lang.T("Create Courses", "Crear cursos")</h2>
        <EditForm Model="newCourse" OnValidSubmit="CreateCourse" FormName="admin-course-form">
            <DataAnnotationsValidator />
            <div class="form-grid">
                <label>@Lang.T("Code", "Código")</label>
                <InputText @bind-Value="newCourse.Code" />
                <label>@Lang.T("Name", "Nombre")</label>
                <InputText @bind-Value="newCourse.Name" />
                <label>@Lang.T("Credits", "Créditos")</label>
                <InputNumber @bind-Value="newCourse.Credits" />
                <button class="btn" type="submit">@Lang.T("Create course", "Crear curso")</button>
            </div>
        </EditForm>
    </div>

    <div class="panel">
        <h3>@Lang.T("Courses", "Cursos")</h3>
        @foreach (var course in Data.Courses)
        {
            <div class="list-item"><strong>@course.Code</strong> - @course.Name (@course.Credits @Lang.T("credits", "créditos"))</div>
        }
    </div>
}

@code {
    private CourseCatalogItem newCourse = new();

    private void CreateCourse()
    {
        if (string.IsNullOrWhiteSpace(newCourse.Code) || string.IsNullOrWhiteSpace(newCourse.Name) || newCourse.Credits <= 0)
        {
            return;
        }

        Data.CreateCourse(new CourseCatalogItem
        {
            Code = newCourse.Code.Trim(),
            Name = newCourse.Name.Trim(),
            Credits = newCourse.Credits
        });

        newCourse = new CourseCatalogItem();
    }
}
