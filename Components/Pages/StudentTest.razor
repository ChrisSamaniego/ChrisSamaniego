@page "/student/test"
@inject AppStateService AppState
@inject SchoolDataService Data
@inject LanguageService Lang

<PageTitle>@Lang.T("Test", "Examen")</PageTitle>

@if (AppState.CurrentRole != UserRole.Student)
{
    <div class="panel"><p>@Lang.T("Switch to Student role.", "Cambia al rol de Estudiante.")</p></div>
}
else
{
    <div class="panel">
        <h2>@Lang.T("Tests", "Exámenes")</h2>
        @foreach (var questionnaire in Data.Questionnaires)
        {
            var state = GetState(questionnaire);

            <div class="list-item">
                <strong>@questionnaire.Title</strong>

                @if (!questionnaire.Questions.Any())
                {
                    <p>@Lang.T("No questions available in this test yet.", "Aún no hay preguntas disponibles en este examen.")</p>
                }
                else
                {
                    @for (var i = 0; i < questionnaire.Questions.Count; i++)
                    {
                        <label><strong>Q@(i + 1).</strong> @questionnaire.Questions[i]</label>
                        <InputTextArea @bind-Value="state.Answers[i]" rows="3" />
                    }

                    <button class="btn" @onclick="() => SubmitAnswers(questionnaire)">@Lang.T("Submit answers", "Enviar respuestas")</button>

                    @if (state.ShowValidation)
                    {
                        <p class="error-text">@Lang.T("Please answer all questions before submitting.", "Responde todas las preguntas antes de enviar.")</p>
                    }
                }
            </div>
        }
    </div>
}

@code {
    private readonly Dictionary<Guid, TestAnswerState> testStates = new();

    private TestAnswerState GetState(Questionnaire questionnaire)
    {
        if (!testStates.TryGetValue(questionnaire.Id, out var state))
        {
            state = new TestAnswerState(questionnaire.Questions.Count);
            testStates[questionnaire.Id] = state;
        }

        if (state.Answers.Count != questionnaire.Questions.Count)
        {
            state = new TestAnswerState(questionnaire.Questions.Count);
            testStates[questionnaire.Id] = state;
        }

        return state;
    }

    private void SubmitAnswers(Questionnaire questionnaire)
    {
        var state = GetState(questionnaire);

        if (state.Answers.Any(answer => string.IsNullOrWhiteSpace(answer)))
        {
            state.ShowValidation = true;
            return;
        }

        var response = new QuestionnaireResponse
        {
            StudentName = AppState.CurrentStudentName,
            SubmittedAt = DateTime.UtcNow,
            Answer = string.Join(Environment.NewLine,
                state.Answers.Select((answer, index) => $"Q{index + 1}: {answer.Trim()}"))
        };

        Data.SubmitResponse(questionnaire.Id, response);
        testStates[questionnaire.Id] = new TestAnswerState(questionnaire.Questions.Count);
    }

    private class TestAnswerState
    {
        public TestAnswerState(int questionCount)
        {
            Answers = Enumerable.Repeat(string.Empty, questionCount).ToList();
        }

        public List<string> Answers { get; }

        public bool ShowValidation { get; set; }
    }
}
