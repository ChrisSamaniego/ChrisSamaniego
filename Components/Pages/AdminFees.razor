@page "/admin/fees"
@inject AppStateService AppState
@inject SchoolDataService Data

<PageTitle>Admin Fees</PageTitle>

@if (AppState.CurrentRole != UserRole.Administrator)
{
    <div class="panel"><p>Switch to Administrator role.</p></div>
}
else
{
    <div class="panel">
        <h2>Admin Fees</h2>
        <EditForm Model="newFee" OnValidSubmit="CreateFee" FormName="admin-fee-form">
            <DataAnnotationsValidator />
            <div class="form-grid">
                <label>Course name</label>
                <InputText @bind-Value="newFee.CourseName" />
                <label>Amount</label>
                <InputNumber @bind-Value="newFee.Amount" />
                <label>Currency</label>
                <InputText @bind-Value="newFee.Currency" />
                <label>Billing period</label>
                <InputText @bind-Value="newFee.BillingPeriod" />
                <button class="btn" type="submit">Add fee</button>
            </div>
        </EditForm>
    </div>

    <div class="panel">
        <h3>Fees</h3>
        @foreach (var fee in Data.CourseFees)
        {
            <div class="list-item">@fee.CourseName - @fee.Currency @fee.Amount.ToString("0.00") (@fee.BillingPeriod)</div>
        }
    </div>
}

@code {
    private CourseFee newFee = new() { Currency = "USD", BillingPeriod = "Monthly" };

    private void CreateFee()
    {
        if (string.IsNullOrWhiteSpace(newFee.CourseName) || newFee.Amount <= 0)
        {
            return;
        }

        Data.AddCourseFee(new CourseFee
        {
            CourseName = newFee.CourseName.Trim(),
            Amount = newFee.Amount,
            Currency = string.IsNullOrWhiteSpace(newFee.Currency) ? "USD" : newFee.Currency.Trim(),
            BillingPeriod = string.IsNullOrWhiteSpace(newFee.BillingPeriod) ? "Monthly" : newFee.BillingPeriod.Trim()
        });

        newFee = new CourseFee { Currency = "USD", BillingPeriod = "Monthly" };
    }
}
