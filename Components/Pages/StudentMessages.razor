@page "/student/contact"
@inject AppStateService AppState
@inject SchoolDataService Data

<PageTitle>Contact</PageTitle>

@if (AppState.CurrentRole != UserRole.Student)
{
    <div class="panel"><p>Switch to Student role.</p></div>
}
else
{
    <div class="responsive-grid">
        <div class="panel">
            <h2>Contact administrator</h2>
            <EditForm Model="newMessage" OnValidSubmit="SendMessage">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <div class="form-grid">
                    <label>Subject</label>
                    <InputText @bind-Value="newMessage.Subject" placeholder="Example: Need help with class schedule" />
                    <label>Message</label>
                    <InputTextArea @bind-Value="newMessage.Content" rows="5" placeholder="Write your message for the administrator" />
                    <button class="btn" type="submit">Send message</button>
                </div>
            </EditForm>
        </div>

        <div class="panel">
            <h2>Contact history</h2>
            @foreach (var message in MyMessages)
            {
                <div class="list-item">
                    <strong>@message.Subject</strong>
                    <div><small>Sent @message.SentAt.ToLocalTime():g</small></div>
                    <p>@message.Content</p>

                    @if (string.IsNullOrWhiteSpace(message.AdminReply))
                    {
                        <span class="status-tag pending">Pending administrator reply</span>
                    }
                    else
                    {
                        <div class="message-reply">
                            <strong>Administrator</strong>
                            <p>@message.AdminReply</p>
                            <small>Replied @message.RepliedAt?.ToLocalTime():g</small>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
}

@code {
    private MessageForm newMessage = new();

    private IEnumerable<AdminMessage> MyMessages => Data.AdminMessages
        .Where(m => string.Equals(m.StudentName, AppState.CurrentStudentName, StringComparison.OrdinalIgnoreCase))
        .OrderByDescending(m => m.SentAt);

    private void SendMessage()
    {
        Data.SendMessageToAdmin(AppState.CurrentStudentName, newMessage.Subject, newMessage.Content);
        newMessage = new MessageForm();
    }

    private class MessageForm
    {
        [Required]
        public string Subject { get; set; } = string.Empty;

        [Required]
        public string Content { get; set; } = string.Empty;
    }
}
